# =========================================================================
# CONFIGURACIÓN DE DESPLIEGUE DOCKER Y NGINX PROXY MANAGER (NPM)
# =========================================================================

# --- 1. CONFIGURACIÓN GENERAL DEL SISTEMA ---
APP_NAME="Graderias Carnaval Oruro"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:rx/UmZ4ROeDcwpvzXKhxn+wPbnRqufN0rP7fNF3PfrY=

# --- 2. PUERTOS EXPUESTOS EN EL HOST ---
# Cambia estos puertos si ya tienes otros servicios corriendo en tu servidor
FRONTEND_PORT=8080
BACKEND_PORT=8000
DB_PORT=3306

# --- 3. BASE DE DATOS MYSQL ---
DB_DATABASE=back_graderias
DB_USERNAME=graderias_user
DB_PASSWORD=GraderiasSecretPassword2026!
DB_ROOT_PASSWORD=GraderiasRootPassword2026!

# --- 4. URLS PÚBLICAS PARA EL CLIENTE Y NGINX PROXY MANAGER ---
# IMPORTANTE: Estas URLs son las que el navegador de los usuarios usará para consultar la API.
#
# Caso A: Si usas dominios con Nginx Proxy Manager (Recomendado):
# BACKEND_URL=https://api.tudominio.com
# PUBLIC_API_URL=https://api.tudominio.com/api
# PUBLIC_AVATAR_URL=https://api.tudominio.com/images
#
# Caso B: Si accedes por IP de Red Local (LAN) o VPS directa:
# BACKEND_URL=http://192.168.1.100:8000
# PUBLIC_API_URL=http://192.168.1.100:8000/api
# PUBLIC_AVATAR_URL=http://192.168.1.100:8000/images
#
# Caso C: Desarrollo local en la misma máquina (localhost):
BACKEND_URL=http://localhost:8000
PUBLIC_API_URL=http://localhost:8000/api
PUBLIC_AVATAR_URL=http://localhost:8000/images

# Forzar ejecución de seeders en cada inicio (false por defecto para proteger datos)
RUN_SEEDERS=false
